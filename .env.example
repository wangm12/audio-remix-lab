# Database
DATABASE_URL=postgresql+asyncpg://remix:remix@localhost:5432/remix_studio
DB_PASSWORD=remix

# Auth. `make env` replaces an empty or short JWT_SECRET with a random value.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Set to true when the app is reached over HTTPS (for example through a tunnel).
COOKIE_SECURE=false
# When set, new accounts must enter this code to register.
REGISTRATION_INVITE_CODE=
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
STORAGE_PATH=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ACE-Step (local engine)
ACESTEP_ENABLED=true
ACESTEP_API_BASE=http://localhost:8001
ACESTEP_MODEL=acestep-v15-turbo
